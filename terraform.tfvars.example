# Example variable file for deploying Microsoft Fabric resources.
# Replace the placeholder values with your environment specific details
# before copying this file to terraform.tfvars (which is ignored by Git).

client              = "acme"
environment         = "dev"   # dev | test | prod
location            = "francecentral"
fabric_capacity_sku = "F2"
subscription_id     = "00000000-0000-0000-0000-000000000000"

workspace_group_assignments = [
    {
        group_object_id    = "groupeAD_ID"
        role               = "Contributor"
        workspaces         = ["workspace_name1", "workspace_name2"]
    }
]