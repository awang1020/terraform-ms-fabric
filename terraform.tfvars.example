# Example variable file for deploying Microsoft Fabric resources.
# Replace the placeholder values with your environment specific details
# before copying this file to terraform.tfvars (which is ignored by Git).

client              = "customer"                              # string; naming prefix (lowercase, digits, hyphens)
environment         = "dev"                               # string; one of: dev | test | prod
location            = "francecentral"                     # string; Azure region (default: "francecentral")
fabric_capacity_sku = "F2"                                 # string; Fabric capacity size (default: "F2")
subscription_id     = "00000000-0000-0000-0000-000000000000" # string; Azure subscription ID

# Optional: common tags applied to supported resources (map(string), default: {})
tags = {
  environment = "dev"
  owner       = "data-team"
}

# Lakehouse configuration
# Enables schemas feature on created lakehouses (bool; default: true). Changes may force replacement.
enable_schemas = true

# Artefact name usage tokens (customize middle segment of <service>_<usage>_<workspace>)
artifacts_dataflow_usage  = "ingestion"       # string; default: "ingest"
artifacts_pipeline_usage  = "orchestration"  # string; default: "orchestrate"
artifacts_notebook_usage  = "preparation"      # string; default: "explore"

workspace_group_assignments = [                 # list(object), optional
  {
    # Prefer object IDs (discouraged: display name lookup)
    group_object_id    = "<aad-group-object-id>"
    # group_display_name = "<AAD Group Name>"

    # Role within each workspace: Admin | Member | Contributor | Viewer
    role               = "Contributor"

    # Restrict to these workspaces by display name. Empty => all created workspaces.
    workspaces         = ["customer-DEV", "customer-TEST"]
  }
]

# Deployment Pipeline role assignments (optional)
# Assign roles on the Fabric Deployment Pipeline to AAD groups or users.
# Prefer object IDs for principals:
#   - For groups: group_object_id (discouraged: group_display_name)
#   - For users:  user_object_id  (discouraged: user_principal_name)
# Only role supported on deployment pipeline is: Admin
deployment_pipeline_role_assignments = [
  # Example: assign Admin to a platform group by object ID
  {
    role               = "Admin"
    principal_type     = "Group"           # "Group" or "User"
    group_object_id    = "<aad-group-object-id>"
  },
  # Example: assign Admin to a specific user by object ID
  {
    role                 = "Admin"
    principal_type       = "User"
    user_object_id       = "<aad-user-object-id>"
  }
]
